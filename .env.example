# Sycophancy RL Environment — Environment Variables
# Copy this to .env and fill in your real values

# HuggingFace API token (write access required for pushing model weights)
HF_TOKEN=your_huggingface_token_here

# URL of the deployed environment server (used by the demo Space)
HF_SPACE_URL=https://your-username-sycophancy-env.hf.space

# HuggingFace model repo to push trained weights to
HF_REPO_ID=your-username/sycophancy-resistant-model

# Base model for training
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Port the FastAPI environment server runs on
ENVIRONMENT_PORT=7860

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
